Options -Indexes
RewriteEngine On

# ── إذا كان الموقع في مجلد فرعي مثل /dalil، غيّر السطر التالي:
RewriteBase /dalil/

# ── Static assets — serve directly ──────────────────────
RewriteRule ^assets/(.*)$  assets/$1   [L]
RewriteRule ^favicon\.svg$ favicon.svg [L]

# ── API routes → api.php ──────────────────────────────────
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/(.*)$ api.php [L,QSA]

# ── Admin ─────────────────────────────────────────────────
RewriteRule ^mhd-admin/?$    admin/index.php [L,QSA]
RewriteRule ^mhd-admin/(.+)$ admin/index.php [L,QSA]

# ── Page routes → pages/*.php ─────────────────────────────
RewriteRule ^courses/?$    pages/courses.php    [L,QSA]
RewriteRule ^materials/?$  pages/materials.php  [L,QSA]
RewriteRule ^exams/?$      pages/exams.php      [L,QSA]
RewriteRule ^questions/?$  pages/questions.php  [L,QSA]
RewriteRule ^weekly/?$     pages/weekly.php     [L,QSA]
RewriteRule ^news/?$       pages/news.php       [L,QSA]
RewriteRule ^resources/?$  pages/resources.php  [L,QSA]
RewriteRule ^notes/?$      pages/notes.php      [L,QSA]
RewriteRule ^progress/?$   pages/progress.php   [L,QSA]
RewriteRule ^gpa/?$        pages/gpa.php        [L,QSA]
RewriteRule ^focus/?$      pages/focus.php      [L,QSA]
RewriteRule ^quiz/?$       pages/quiz.php       [L,QSA]
RewriteRule ^flashcards/?$ pages/flashcards.php [L,QSA]

# ── Root → index.php ──────────────────────────────────────
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^$ index.php [L,QSA]
RewriteRule ^index/?$ index.php [L,QSA]

# ── Security headers ──────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── GZIP compression ─────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# ── PHP settings ──────────────────────────────────────────
<IfModule mod_php.c>
    php_value default_charset "UTF-8"
    php_value display_errors 0
    php_value log_errors 1
</IfModule>